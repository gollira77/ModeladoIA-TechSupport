# Copiar este archivo como .env y ajustar.

# --- Ollama ---
OLLAMA_API_BASE=http://localhost:11434
# Modelo del agente: el Qwen3.5-4B que cuantizamos a Q4_K_M (ver modelo/MODELFILE.txt)
MODELO_AGENTE=ollama_chat/qwen3.5:4b_K_M
# Modelo con visión para leer capturas/fotos (de la librería de Ollama)
MODELO_VISION=qwen3.5:4b
MODELO_EMBEDDINGS=nomic-embed-text
TEMPERATURA=0.1
DESACTIVAR_THINKING=true

# --- Seguridad ---
# Generar uno propio, por ejemplo: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=cambiar-este-secreto-en-produccion
JWT_EXPIRA_MINUTOS=480
MAX_MENSAJE_CARACTERES=4000
MAX_ARCHIVO_MB=8
MENSAJES_POR_MINUTO=12

# --- RAG ---
UMBRAL_DUPLICADO=0.55

# --- Solo para probar con `adk web agents` (no hay login allí) ---
ADK_WEB_USUARIO_DEMO=lucia.gomez

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
